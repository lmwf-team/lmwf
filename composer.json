{
    "authors": [
        {
            "name": "Matl",
            "role": "Developer"
        }
    ],
    "name": "lmwf-team/lmwf",
    "description": "Lightweight web framework that doesn’t require tons of dependencies and keeps you in control.",
    "autoload": {
        "psr-4": {
            "LM\\WebFramework\\": "src/"
        }
    },
    "keywords": [
        "web",
        "framework",
        "lightweight"
    ],
    "license": "MIT",
    "require": {
        "php-di/php-di": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "voku/portable-ascii": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^1.11",
        "ergebnis/phpstan-rules": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.66",
        "spaze/phpstan-disallowed-calls": "^3.4"
    }
}
