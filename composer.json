{
    "authors": [
        {
            "name": "Matl",
            "role": "Developer"
        }
    ],
    "name": "lmwf-team/lmwf",
    "description": "Lightweight web framework that doesn't require tons of dependencies and keeps you in control.",
    "autoload": {
        "psr-4": {
            "LMWF\\": "src/"
        }
    },
    "keywords": [
        "web",
        "framework",
        "lightweight"
    ],
    "license": "MIT",
    "require": {
        "php-di/php-di": "^7.1",
        "guzzlehttp/guzzle": "^7.14",
        "voku/portable-ascii": "^2.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "squizlabs/php_codesniffer": "^4.0",
        "spaze/phpstan-disallowed-calls": "^4.13",
        "ergebnis/phpstan-rules": "^2.13",
        "phpstan/phpstan-strict-rules": "^2.0",
        "deptrac/deptrac": "^4.7"
    }
}
